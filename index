    var qty=1;
    $("#sp-minus",el).addEventListener("click",function(){ qty=Math.max(1,qty-1); $("#sp-qty-val",el).textContent=qty; });
    $("#sp-plus",el).addEventListener("click",function(){ qty=qty+1; $("#sp-qty-val",el).textContent=qty; });
    $("#sp-submit").addEventListener("click",function(){
      var part=$("#sp-part",el).value.trim();
      if(!part){ toast("Enter the part used.",true); return; }
      if(!reason.get()){ toast("Pick a reason.",true); return; }
      var equipSel=$("#sp-equip",el); var equipName=equipSel.options[equipSel.selectedIndex]? (equipSel.options[equipSel.selectedIndex].getAttribute("data-name")||"Not equipment-specific"):"";
      var entry={
        type:"spares", createdAt:Date.now(), siteId:S.site, siteName:site?site.name:"",
        equipmentId:equipSel.value, equipmentName:equipName,
        workerId:S.worker.id, workerName:S.worker.name,
        part:part, code:$("#sp-code",el).value.trim(), qty:qty, reason:reason.get(),
        status:"Logged", notes:$("#sp-notes",el).value.trim()
      };
      submitEntry(entry,"Spares usage logged.");
    });
  }

  /* ---- Task/Issue form ---- */
  function renderTaskForm(el){
    var workerOpts=(S.roster.workers||[]).map(function(w){return '<option value="'+esc(w.id)+'" data-name="'+esc(w.name)+'">'+esc(w.name)+'</option>';}).join("");
    el.innerHTML='<div class="form-shell">'+formHead("Log a Task / Issue")+contextStrip()+
      '<div class="field-group"><span class="field-label">Category</span>'+chipRowHTML("tk-cat",TASK_CATEGORIES)+'</div>'+
      '<div class="field-group"><span class="field-label">Priority</span>'+segmentedHTML("tk-pri",TASK_PRIORITY)+'</div>'+
      '<div class="field-group"><span class="field-label">Description</span><textarea id="tk-desc" placeholder="What needs attention?"></textarea></div>'+
      '<div class="field-group"><span class="field-label">Assign To (optional)</span><select id="tk-assignee"><option value="">Unassigned</option>'+workerOpts+'</select></div>'+
      '<button class="submit-btn" id="tk-submit">Log Task / Issue</button></div>';
    wireBack(el);
    var cat=wireChipRow(el,"tk-cat"), pri=wireSegmented(el,"tk-pri");
    $("#tk-submit").addEventListener("click",function(){
      var desc=$("#tk-desc",el).value.trim();
      if(!cat.get()){ toast("Pick a category.",true); return; }
      if(!pri.get()){ toast("Pick a priority.",true); return; }
      if(!desc){ toast("Describe the issue.",true); return; }
      var site=currentSiteObj();
      var aSel=$("#tk-assignee",el); var aName=aSel.value? (aSel.options[aSel.selectedIndex].getAttribute("data-name")||""):"";
      var entry={
        type:"task", createdAt:Date.now(), siteId:S.site, siteName:site?site.name:"",
        equipmentId:"", equipmentName:"",
        workerId:S.worker.id, workerName:S.worker.name,
        category:cat.get(), priority:pri.get(), desc:desc, status:"Open",
        assignee:aSel.value, assigneeName:aName
      };
      submitEntry(entry,"Task logged.");
    });
  }

  function submitEntry(entry, msg){
    S.entries.unshift(Object.assign({id:"pending-"+Date.now()},entry)); // optimistic
    renderScreen === renderScreen; // no-op, keep linter happy
    Store.addEntry(entry).then(function(){ toast(msg); setTimeout(function(){navigate("home");},500); refresh(); }).catch(function(err){ apiErr(err); refresh(); });
  }

  /* ================= Supervisor Dashboard ================= */
  function renderDashboard(el){
    if(!S.dashUnlocked){
      el.innerHTML='<div class="pin-card"><div class="eyebrow">Supervisor / AS Lead</div><h2 style="font-size:1.3rem;margin:.4rem 0 1rem;">Enter access code</h2>'+
        '<input type="tel" id="pin-input" maxlength="4" placeholder="••••" autofocus>'+
        '<button class="submit-btn" id="pin-go" style="margin-top:1rem;">Unlock</button>'+
        '<div style="margin-top:1rem;"><button class="btn-link" id="pin-cancel">Back to floor log</button></div></div>';
      $("#pin-cancel",el).addEventListener("click",function(){ navigate(S.worker?"home":"gate"); });
      $("#pin-go",el).addEventListener("click",tryPin);
      $("#pin-input",el).addEventListener("keydown",function(e){ if(e.key==="Enter") tryPin(); });
      function tryPin(){
        var v=$("#pin-input",el).value.trim();
        if(v===(S.settings.pin||"2468")){ S.dashUnlocked=true; renderScreen(); }
        else toast("That code doesn't match.",true);
      }
      return;
    }
    var f=S.filters;
    var rangeMs={today:86400000, "7d":7*86400000, "30d":30*86400000, all:Infinity}[f.range];
    var cutoff=f.range==="today"? new Date().setHours(0,0,0,0) : Date.now()-rangeMs;
    var filtered=S.entries.filter(function(e){
      if(e.createdAt<cutoff) return false;
      if(f.type!=="all" && e.type!==f.type) return false;
      if(f.status!=="all" && (e.status||"")!==f.status) return false;
      if(f.q){
        var hay=[e.equipmentName,e.workerName,e.category,e.part,e.desc,e.task,e.action,e.notes].join(" ").toLowerCase();
        if(hay.indexOf(f.q.toLowerCase())===-1) return false;
      }
      return true;
    });
    var todayAll=S.entries.filter(function(e){return isToday(e.createdAt);});
    var openBd=S.entries.filter(function(e){return e.type==="breakdown"&&e.status==="Open";}).length;
    var downtimeToday=todayAll.filter(function(e){return e.type==="breakdown"&&e.status==="Closed"&&e.downtimeMinutes;}).reduce(function(a,e){return a+Number(e.downtimeMinutes||0);},0);
    var pmToday=todayAll.filter(function(e){return e.type==="pm";}).length;
    var spToday=todayAll.filter(function(e){return e.type==="spares";}).length;
    var openIssues=S.entries.filter(function(e){return e.type==="task"&&e.status!=="Closed";}).length;

    el.innerHTML =
      '<div class="eyebrow">Supervisor / AS Lead</div><h1 class="page-title">All sites at a glance</h1>'+
      '<p class="page-sub">Live feed of everything logged from the floor across every site, backed by your Google Sheet. Refreshes automatically every 20 seconds.</p>'+
      '<div class="kpi-row">'+
        kpi(openBd,"Open Breakdowns","var(--bad)")+
        kpi(downtimeToday+" min","Downtime Today (closed)","var(--bad)")+
        kpi(pmToday,"PM Logged Today","var(--good)")+
        kpi(spToday,"Spares Logged Today","var(--info)")+
        kpi(openIssues,"Open Tasks / Issues","var(--warn)")+
      '</div>'+
      '<div class="filters-bar">'+
        selectFilter("f-type",[["all","All Types"],["breakdown","Breakdown"],["pm","PM"],["spares","Spares"],["task","Task/Issue"]],f.type)+
        selectFilter("f-status",[["all","All Status"],["Open","Open"],["Closed","Closed"],["Logged","Logged"],["Flagged","Flagged"]],f.status)+
        selectFilter("f-range",[["today","Today"],["7d","Last 7 days"],["30d","Last 30 days"],["all","All time"]],f.range)+
        '<input class="search-input" type="text" id="f-q" placeholder="Search equipment, worker, notes…" value="'+esc(f.q)+'">'+
      '</div>'+
      renderTable(filtered)+
      '<div class="dash-actions"><span class="page-sub" style="margin:0;">'+filtered.length+' entr'+(filtered.length===1?"y":"ies")+' matching filters</span>'+
        '<button class="btn-secondary" id="export-csv">Export CSV</button></div>'+
      renderAdmin();

    $("#f-type",el).addEventListener("change",function(){ f.type=this.value; renderDashboard(el); });
    $("#f-status",el).addEventListener("change",function(){ f.status=this.value; renderDashboard(el); });
    $("#f-range",el).addEventListener("change",function(){ f.range=this.value; renderDashboard(el); });
    $("#f-q",el).addEventListener("input",debounce(function(){ f.q=this.value; renderDashboard(el); },300));
    $all("tbody tr[data-id]",el).forEach(function(tr){ tr.addEventListener("click",function(){ openDetail(tr.getAttribute("data-id")); }); });
    $("#export-csv",el).addEventListener("click",function(){ exportCSV(filtered); });
    wireAdmin(el);
  }
  function kpi(value,label,color){
    return '<div class="kpi-card" style="--kpi-color:'+color+'"><div class="kpi-value" style="color:'+color+'">'+value+'</div><div class="kpi-label">'+label+'</div></div>';
  }
  function selectFilter(id,opts,val){
    return '<select id="'+id+'">'+opts.map(function(o){return '<option value="'+o[0]+'"'+(o[0]===val?" selected":"")+'>'+o[1]+'</option>';}).join("")+'</select>';
  }
  var debTimer=null;
  function debounce(fn,ms){ return function(){ var args=arguments,ctx=this; clearTimeout(debTimer); debTimer=setTimeout(function(){fn.apply(ctx,args);},ms); }; }
  function typeDot(type){ return '<span class="type-dot" style="background:'+TYPE_META[type].color+'"></span>'; }
  function statusPill(status){
    var map={Open:"pill-bad",Closed:"pill-good",Logged:"pill-info",Flagged:"pill-warn","Issue Found":"pill-warn"};
    return '<span class="pill '+(map[status]||"pill-info")+'">'+esc(status||"—")+'</span>';
  }
  function entryDetailText(e){
    if(e.type==="breakdown") return esc(e.category)+" · "+esc(e.severity);
    if(e.type==="pm") return esc(e.task);
    if(e.type==="spares") return esc(e.part)+" ×"+e.qty;
    if(e.type==="task") return esc((e.desc||"").slice(0,60))+((e.desc||"").length>60?"…":"");
    return "";
  }
  function renderTable(list){
    if(!list.length){
      return '<div class="table-wrap"><table><tbody><tr class="empty-row"><td>No entries match these filters yet.</td></tr></tbody></table></div>';
    }
    var rows=list.map(function(e){
      return '<tr data-id="'+e.id+'">'+
        '<td style="font-family:var(--font-mono);color:var(--ink-dim);">'+fmtDateTime(e.createdAt)+'</td>'+
        '<td>'+typeDot(e.type)+esc(TYPE_META[e.type].label)+'</td>'+
        '<td>'+esc(e.siteName)+'</td>'+
        '<td>'+esc(e.equipmentName||"—")+'</td>'+
        '<td>'+entryDetailText(e)+'</td>'+
        '<td>'+esc(e.workerName)+'</td>'+
        '<td>'+statusPill(e.status)+'</td>'+
      '</tr>';
    }).join("");
    return '<div class="table-wrap"><table><thead><tr><th>Time</th><th>Type</th><th>Site</th><th>Equipment</th><th>Detail</th><th>Logged By</th><th>Status</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
  }

  function openDetail(id){
    var e=S.entries.find(function(x){return String(x.id)===String(id);});
    if(!e) return;
    var root=$("#drawer-root");
    var rows=[["Type",TYPE_META[e.type].label],["Site",e.siteName],["Equipment",e.equipmentName||"—"],["Logged By",e.workerName],["Logged At",fmtDateTime(e.createdAt)]];
    if(e.type==="breakdown") rows.push(["Category",e.category],["Severity",e.severity],["Start",e.startTime],["End",e.endTime||"—"],["Downtime",e.downtimeMinutes!==""&&e.downtimeMinutes!=null?e.downtimeMinutes+" min":"still open"],["Action Taken",e.action||"—"],["Notes",e.notes||"—"]);
    if(e.type==="pm") rows.push(["Frequency",e.freq],["Task",e.task],["Result",e.result],["Remarks",e.remarks||"—"]);
    if(e.type==="spares") rows.push(["Part",e.part],["Code",e.code||"—"],["Quantity",e.qty],["Reason",e.reason],["Notes",e.notes||"—"]);
    if(e.type==="task") rows.push(["Category",e.category],["Priority",e.priority],["Description",e.desc],["Assigned To",e.assigneeName||"Unassigned"]);
    root.innerHTML='<div class="overlay" id="ov"><div class="drawer">'+
      '<div class="drawer-head"><h2 style="font-size:1.2rem;">'+typeDot(e.type)+esc(TYPE_META[e.type].label)+'</h2><button class="icon-btn" id="drawer-close" style="background:var(--surface-2);border-color:var(--line);color:var(--ink);">'+icon("close","var(--ink)")+'</button></div>'+
      '<dl>'+rows.map(function(r){return '<div class="drawer-row"><dt>'+r[0]+'</dt><dd>'+esc(r[1])+'</dd></div>';}).join("")+'</dl>'+
      '<div class="drawer-actions">'+
      (e.type==="breakdown"&&e.status==="Open" ? '<button class="primary" id="act-close-bd">Close Breakdown Now</button>' : "")+
      (e.type==="task"&&e.status==="Open" ? '<button id="act-inprogress">Mark In Progress</button>' : "")+
      (e.type==="task"&&e.status!=="Closed" ? '<button class="primary" id="act-close-task">Close Task</button>' : "")+
      '</div></div></div>';
    $("#ov").addEventListener("click",function(ev){ if(ev.target.id==="ov") closeDrawer(); });
    $("#drawer-close").addEventListener("click",closeDrawer);
    var b1=$("#act-close-bd"); if(b1) b1.addEventListener("click",function(){
      var end=nowHHMM();
      Store.updateEntry(e.id,{status:"Closed",endTime:end,downtimeMinutes:minutesBetween(e.startTime,end)}).then(function(){ toast("Breakdown closed."); closeDrawer(); refresh(); }).catch(apiErr);
    });
    var b2=$("#act-inprogress"); if(b2) b2.addEventListener("click",function(){
      Store.updateEntry(e.id,{status:"In Progress"}).then(function(){ toast("Marked in progress."); closeDrawer(); refresh(); }).catch(apiErr);
    });
    var b3=$("#act-close-task"); if(b3) b3.addEventListener("click",function(){
      Store.updateEntry(e.id,{status:"Closed"}).then(function(){ toast("Task closed."); closeDrawer(); refresh(); }).catch(apiErr);
    });
  }
  function closeDrawer(){ $("#drawer-root").innerHTML=""; }

  function exportCSV(list){
    var cols=["createdAt","type","siteName","equipmentName","workerName","status","category","severity","startTime","endTime","downtimeMinutes","action","freq","task","result","remarks","part","code","qty","reason","desc","priority","assigneeName","notes"];
    var lines=[cols.join(",")];
    list.forEach(function(e){
      lines.push(cols.map(function(c){
        var v=c==="createdAt"? fmtDateTime(e.createdAt) : (e[c]==null?"":e[c]);
        v=String(v).replace(/"/g,'""');
        return /[",\n]/.test(v) ? '"'+v+'"' : v;
      }).join(","));
    });
    downloadCSV("kengic-as-entries-"+new Date().toISOString().slice(0,10)+".csv", lines.join("\n"));
  }

  /* ---- Admin (roster / sites) ---- */
  function renderAdmin(){
    var sites=(S.catalog.sites||[]);
    var siteBlocks=sites.map(function(site){
      var chips=(site.equipment||[]).map(function(eq){
        return '<span class="equip-chip">'+esc(eq.name)+'<button data-site="'+site.id+'" data-equip="'+eq.id+'" class="rm-equip">×</button></span>';
      }).join("");
      return '<div class="admin-site-block"><strong>'+esc(site.name)+'</strong> <button class="remove-btn rm-site" data-site="'+site.id+'">remove site</button>'+
        '<div class="admin-equip-row">'+(chips||'<span class="field-hint">No equipment yet.</span>')+'</div>'+
        '<div class="mini-form"><input type="text" placeholder="New equipment name" class="new-equip-name" data-site="'+site.id+'"><button class="add-equip" data-site="'+site.id+'">Add</button></div></div>';
    }).join("");
    var workers=(S.roster.workers||[]).map(function(w){
      return '<div class="roster-row"><span class="avatar sm">'+esc(initials(w.name))+'</span><span class="rr-meta">'+esc(w.name)+' <span class="field-hint">'+esc(w.role||"")+'</span></span><button class="remove-btn rm-worker" data-id="'+w.id+'">remove</button></div>';
    }).join("");
    return '<details class="admin-panel"><summary>Sites &amp; Equipment</summary><div class="admin-body">'+
        siteBlocks+
        '<div class="mini-form" style="margin-top:1rem;"><input type="text" id="new-site-name" placeholder="New site name"><button id="add-site">Add Site</button></div>'+
      '</div></details>'+
      '<details class="admin-panel"><summary>Roster</summary><div class="admin-body">'+workers+
        '<div class="mini-form"><input type="text" id="new-worker-name" placeholder="Name"><input type="text" id="new-worker-role" placeholder="Role"><button id="add-worker">Add</button></div>'+
      '</div></details>'+
      '<details class="admin-panel"><summary>Access Code</summary><div class="admin-body">'+
        '<div class="mini-form"><input type="tel" id="new-pin" maxlength="4" placeholder="New 4-digit code"><button id="save-pin">Save</button></div>'+
        '<p class="field-hint">This is a soft floor gate, not a security password — anyone with the app link can view all logged data.</p>'+
      '</div></details>';
  }
  function wireAdmin(root){
    $all(".rm-equip",root).forEach(function(btn){
      btn.addEventListener("click",function(){
        var siteId=btn.getAttribute("data-site"), equipId=btn.getAttribute("data-equip");
        var newCatalog={sites:S.catalog.sites.map(function(s){
          if(s.id!==siteId) return s;
          return Object.assign({},s,{equipment:s.equipment.filter(function(eq){return eq.id!==equipId;})});
        })};
        Store.saveCatalog(newCatalog).then(function(){ S.catalog=newCatalog; toast("Equipment removed."); refresh(); }).catch(apiErr);
      });
    });
    $all(".rm-site",root).forEach(function(btn){
      btn.addEventListener("click",function(){
        var siteId=btn.getAttribute("data-site");
        var newCatalog={sites:S.catalog.sites.filter(function(s){return s.id!==siteId;})};
        Store.saveCatalog(newCatalog).then(function(){ S.catalog=newCatalog; toast("Site removed."); refresh(); }).catch(apiErr);
      });
    });
    $all(".add-equip",root).forEach(function(btn){
      btn.addEventListener("click",function(){
        var siteId=btn.getAttribute("data-site");
        var input=$(".new-equip-name[data-site='"+siteId+"']",root);
        var name=input.value.trim(); if(!name) return;
        var newCatalog={sites:S.catalog.sites.map(function(s){
          if(s.id!==siteId) return s;
          return Object.assign({},s,{equipment:(s.equipment||[]).concat([{id:uid("eq"),name:name}])});
        })};
        Store.saveCatalog(newCatalog).then(function(){ S.catalog=newCatalog; toast("Equipment added."); refresh(); }).catch(apiErr);
      });
    });
    var addSite=$("#add-site",root);
    if(addSite) addSite.addEventListener("click",function(){
      var name=$("#new-site-name",root).value.trim(); if(!name) return;
      var newCatalog={sites:S.catalog.sites.concat([{id:uid("site"),name:name,equipment:[]}])};
      Store.saveCatalog(newCatalog).then(function(){ S.catalog=newCatalog; toast("Site added."); refresh(); }).catch(apiErr);
    });
    $all(".rm-worker",root).forEach(function(btn){
      btn.addEventListener("click",function(){
        var id=btn.getAttribute("data-id");
        var newRoster={workers:S.roster.workers.filter(function(w){return w.id!==id;})};
        Store.saveRoster(newRoster).then(function(){ S.roster=newRoster; toast("Removed from roster."); refresh(); }).catch(apiErr);
      });
    });
    var addWorker=$("#add-worker",root);
    if(addWorker) addWorker.addEventListener("click",function(){
      var name=$("#new-worker-name",root).value.trim(), role=$("#new-worker-role",root).value.trim();
      if(!name) return;
      var newRoster={workers:S.roster.workers.concat([{id:uid("w"),name:name,role:role||"AS Technician"}])};
      Store.saveRoster(newRoster).then(function(){ S.roster=newRoster; toast("Worker added."); refresh(); }).catch(apiErr);
    });
    var savePin=$("#save-pin",root);
    if(savePin) savePin.addEventListener("click",function(){
      var v=$("#new-pin",root).value.trim();
      if(!/^\d{4}$/.test(v)){ toast("Enter a 4-digit code.",true); return; }
      var newSettings=Object.assign({},S.settings,{pin:v});
      Store.saveSettings(newSettings).then(function(){ S.settings=newSettings; toast("Access code updated."); refresh(); }).catch(apiErr);
    });
  }

  /* ================= Boot / polling ================= */
  function refresh(){
    if(!S.configured) return;
    Store.bootstrap().then(function(data){
      S.catalog = (data && data.catalog) || S.catalog || CATALOG_SEED;
      S.roster = (data && data.roster) || S.roster || ROSTER_SEED;
      S.settings = (data && data.settings) || S.settings || SETTINGS_SEED;
      S.entries = (data && data.entries) || [];
      S.connected = true;
      if(!S.worker && savedWorkerId){
        var w=(S.roster.workers||[]).find(function(x){return x.id===savedWorkerId;});
        if(w){ S.worker=w; if(S.screen==="gate") S.screen="home"; }
      }
      renderScreen();
    }).catch(function(err){
      S.connected = false;
      if(!S.catalog){ S.catalog=CATALOG_SEED; S.roster=ROSTER_SEED; S.settings=SETTINGS_SEED; }
      apiErr(err);
      renderScreen();
    });
  }
  renderScreen();
  refresh();
  setInterval(refresh, POLL_MS);
})();
</script>
</body>
</html>
