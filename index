  /* ================= JSONP transport to the Apps Script web app =====
     Google Apps Script web-app responses are not reliably readable via
     fetch() from another origin (CORS on the redirect it issues), so
     every call — reads AND writes — goes through a <script src> tag
     with a callback, which is never subject to CORS. See
     SETUP_GUIDE.md for the matching doGet() in Code.gs. ================ */
  function callApi(action, payload){
    return new Promise(function(resolve, reject){
      if(!APPS_SCRIPT_URL || APPS_SCRIPT_URL.indexOf("PASTE_YOUR") === 0){
        reject(new Error("not_configured")); return;
      }
      var cbName = "__kengicCb" + Date.now().toString(36) + Math.random().toString(36).slice(2);
      var script = document.createElement("script");
      var done=false;
      var timer = setTimeout(function(){ if(done) return; done=true; cleanup(); reject(new Error("timeout")); }, 15000);
      function cleanup(){ clearTimeout(timer); try{ delete window[cbName]; }catch(e){ window[cbName]=undefined; } if(script.parentNode) script.parentNode.removeChild(script); }
      window[cbName] = function(result){ if(done) return; done=true; cleanup(); resolve(result); };
      script.onerror = function(){ if(done) return; done=true; cleanup(); reject(new Error("network")); };
      var url = APPS_SCRIPT_URL + "?callback=" + encodeURIComponent(cbName) + "&action=" + encodeURIComponent(action) + "&payload=" + encodeURIComponent(JSON.stringify(payload||{}));
      script.src = url;
      document.head.appendChild(script);
    });
  }

