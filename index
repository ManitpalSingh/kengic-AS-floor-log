<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Kengic AS Floor Log</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{
    --bg:#f5f2ea; --surface:#ffffff; --surface-2:#efe9db;
    --ink:#181c22; --ink-dim:#5c6472; --line:#ddd5c2;
    --chrome-bg:#1b2028; --chrome-ink:#f2ede1; --chrome-line:#333b47; --chrome-soft:rgba(242,237,225,.08);
    --accent:#d9660c; --accent-ink:#fff8f0; --accent-soft:#fbe4cc;
    --good:#28825f; --good-soft:#dcefe4;
    --warn:#a8760a; --warn-soft:#f4e6c6;
    --bad:#bb3f34; --bad-soft:#f6dcd8;
    --info:#2f6699; --info-soft:#dde9f2;
    --shadow:rgba(24,28,34,.10);
    --radius:14px;
    --font-display:'Big Shoulders Display',"Arial Narrow",sans-serif;
    --font-body:'IBM Plex Sans',system-ui,-apple-system,sans-serif;
    --font-mono:'IBM Plex Mono',ui-monospace,"SFMono-Regular",monospace;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#11141a; --surface:#181c24; --surface-2:#1f2530;
      --ink:#eef0f2; --ink-dim:#98a1ad; --line:#2a303b;
      --chrome-bg:#0d1015; --chrome-ink:#f2ede1; --chrome-line:#262c35; --chrome-soft:rgba(242,237,225,.06);
      --accent:#ff8f4d; --accent-ink:#1a0e04; --accent-soft:#3a2415;
      --good:#49bd90; --good-soft:#123326;
      --warn:#dcab4a; --warn-soft:#3a2c0f;
      --bad:#e2726a; --bad-soft:#3a1a17;
      --info:#75aee0; --info-soft:#152a3d;
      --shadow:rgba(0,0,0,.45);
    }
  }
  *{box-sizing:border-box;}
  [hidden]{display:none !important;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg);color:var(--ink);font-family:var(--font-body);line-height:1.45;}
  h1,h2,h3{font-family:var(--font-display);font-weight:900;letter-spacing:.01em;margin:0;}
  button,input,select,textarea{font-family:inherit;color:inherit;}
  button{cursor:pointer;}
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  @media (prefers-reduced-motion:reduce){*{animation-duration:.001ms !important;transition-duration:.001ms !important;}}

  #app{min-height:100vh;display:flex;flex-direction:column;background:var(--bg);}

  .chrome{
    position:sticky;top:0;z-index:20;background:var(--chrome-bg);color:var(--chrome-ink);
    border-bottom:1px solid var(--chrome-line);
    display:flex;align-items:center;gap:1.1rem;flex-wrap:wrap;
    padding:.6rem clamp(1rem,4vw,2.5rem);
  }
  .brand{display:flex;align-items:center;gap:.55rem;}
  .brand svg{flex:none;}
  .brand-text{display:flex;flex-direction:column;line-height:1.05;}
  .brand-mark{font-family:var(--font-display);font-weight:900;font-size:1.25rem;letter-spacing:.03em;}
  .brand-tag{font-family:var(--font-mono);font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;opacity:.62;}
  .chrome-controls{display:flex;align-items:center;gap:.7rem;margin-left:auto;flex-wrap:wrap;}
  .site-select{
    background:var(--chrome-soft);border:1px solid var(--chrome-line);color:var(--chrome-ink);
    padding:.5rem .7rem;border-radius:9px;font-size:.85rem;max-width:180px;
  }
  .site-select option{color:#111;}
  .sync-dot{width:8px;height:8px;border-radius:50%;background:var(--good);flex:none;}
  .sync-dot.off{background:var(--bad);}
  .sync-label{font-family:var(--font-mono);font-size:.68rem;opacity:.75;display:flex;align-items:center;gap:.4rem;}
  .clock{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-size:.88rem;opacity:.85;min-width:5.6em;text-align:right;}
  .worker-chip{display:flex;align-items:center;gap:.5rem;background:var(--chrome-soft);border:1px solid var(--chrome-line);border-radius:999px;padding:.3rem .7rem .3rem .3rem;}
  .avatar{flex:none;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;}
  .avatar.sm{width:28px;height:28px;font-size:.78rem;}
  .avatar.md{width:44px;height:44px;font-size:1rem;}
  .avatar.lg{width:56px;height:56px;font-size:1.2rem;}
  .worker-name{font-size:.85rem;font-weight:600;}
  .btn-link{background:none;border:none;font-family:var(--font-mono);font-size:.72rem;letter-spacing:.03em;text-decoration:underline;color:var(--chrome-ink);opacity:.72;padding:0;}
  .btn-link:hover{opacity:1;}
  .icon-btn{width:38px;height:38px;border-radius:50%;background:var(--chrome-soft);border:1px solid var(--chrome-line);color:var(--chrome-ink);display:flex;align-items:center;justify-content:center;flex:none;}
  .icon-btn:hover{background:rgba(255,255,255,.14);}

  .screen{flex:1;width:100%;max-width:1180px;margin:0 auto;padding:1.4rem clamp(1rem,4vw,2.5rem) 3.5rem;}
  .eyebrow{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-dim);}
  .page-title{font-size:clamp(1.5rem,3vw,2.1rem);margin-top:.2rem;}
  .page-sub{color:var(--ink-dim);font-size:.92rem;margin-top:.35rem;max-width:60ch;}

  .setup-card{max-width:640px;margin:3rem auto;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:1.8rem;}
  .setup-card ol{padding-left:1.2rem;}
  .setup-card li{margin-bottom:.6rem;}
  .setup-card code{background:var(--surface-2);padding:.15rem .4rem;border-radius:5px;font-family:var(--font-mono);font-size:.85rem;}

  .gate-head{text-align:left;margin-bottom:1.6rem;}
  .roster-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:.8rem;}
  .roster-tile{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    padding:1.1rem .6rem;display:flex;flex-direction:column;align-items:center;gap:.5rem;text-align:center;
    box-shadow:0 1px 2px var(--shadow);transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  }
  .roster-tile:hover,.roster-tile:focus-visible{transform:translateY(-3px);box-shadow:0 8px 18px var(--shadow);border-color:var(--accent);}
  .roster-name{font-weight:600;font-size:.9rem;}
  .roster-role{font-family:var(--font-mono);font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-dim);}
  .quick-add{margin-top:1.6rem;background:var(--surface-2);border:1px dashed var(--line);border-radius:var(--radius);padding:1rem 1.1rem;max-width:420px;}
  .quick-add-row{display:flex;gap:.5rem;margin-top:.6rem;flex-wrap:wrap;}
  .quick-add-row input{flex:1;min-width:120px;}

  .today-strip{display:flex;gap:.7rem;overflow-x:auto;padding-bottom:.3rem;margin-top:1.1rem;-webkit-mask-image:linear-gradient(90deg,#000 92%,transparent);mask-image:linear-gradient(90deg,#000 92%,transparent);}
  .stat-chip{flex:none;min-width:128px;background:var(--surface);border:1px solid var(--line);border-radius:11px;padding:.65rem .85rem;}
  .stat-value{font-family:var(--font-display);font-size:1.5rem;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;}
  .stat-label{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-dim);margin-top:.2rem;}
  .tiles-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem;margin-top:1.4rem;}
  .tile{
    background:var(--surface);border:1px solid var(--line);border-left:5px solid var(--tile-color,var(--accent));
    border-radius:var(--radius);padding:1.4rem;text-align:left;display:flex;flex-direction:column;gap:.7rem;
    min-height:150px;box-shadow:0 1px 2px var(--shadow);transition:transform .12s ease, box-shadow .12s ease;
  }
  .tile:hover,.tile:focus-visible{transform:translateY(-3px);box-shadow:0 10px 22px var(--shadow);}
  .tile-icon{width:44px;height:44px;border-radius:11px;background:var(--tile-soft,var(--accent-soft));color:var(--tile-color,var(--accent));display:flex;align-items:center;justify-content:center;}
  .tile-title{font-size:1.28rem;}
  .tile-desc{color:var(--ink-dim);font-size:.84rem;}

  .form-shell{max-width:640px;margin:0 auto;}
  .form-head{display:flex;align-items:center;gap:.8rem;margin-bottom:1rem;}
  .context-strip{
    font-family:var(--font-mono);font-size:.74rem;color:var(--ink-dim);background:var(--surface-2);
    border-radius:9px;padding:.55rem .8rem;margin-bottom:1.3rem;display:flex;gap:1.1rem;flex-wrap:wrap;
  }
  .context-strip b{color:var(--ink);font-weight:600;}
  .field-group{display:flex;flex-direction:column;gap:.4rem;margin-bottom:1.15rem;}
  .field-label{font-size:.74rem;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--ink-dim);}
  select,input[type=text],input[type=time],input[type=number],input[type=tel],textarea{
    width:100%;padding:.75rem .85rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);
    color:var(--ink);font-size:.96rem;
  }
  textarea{resize:vertical;min-height:5.2em;}
  .chip-row{display:flex;flex-wrap:wrap;gap:.55rem;}
  .chip{padding:.55rem .95rem;border-radius:999px;border:1px solid var(--line);background:var(--surface);font-weight:600;font-size:.84rem;user-select:none;}
  .chip.selected{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);}
  .segmented{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;width:100%;}
  .segmented button{flex:1;padding:.7rem .5rem;background:var(--surface);border:none;border-right:1px solid var(--line);font-weight:600;font-size:.86rem;}
  .segmented button:last-child{border-right:none;}
  .segmented button.selected{background:var(--accent);color:var(--accent-ink);}
  .stepper{display:flex;align-items:center;gap:.8rem;}
  .stepper button{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:var(--surface);font-size:1.1rem;font-weight:700;}
  .stepper-value{font-family:var(--font-mono);font-size:1.2rem;font-weight:600;min-width:2.4ch;text-align:center;font-variant-numeric:tabular-nums;}
  .submit-btn{
    width:100%;padding:1rem;background:var(--accent);color:var(--accent-ink);border:none;border-radius:12px;
    font-family:var(--font-display);font-weight:700;font-size:1.08rem;letter-spacing:.02em;margin-top:.4rem;
    box-shadow:0 6px 16px var(--shadow);
  }
  .submit-btn:active{transform:scale(.98);}
  .submit-btn:disabled{opacity:.5;cursor:not-allowed;}

  .pin-card{max-width:340px;margin:3.5rem auto 0;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:2rem 1.6rem;text-align:center;box-shadow:0 6px 18px var(--shadow);}
  .pin-card input{text-align:center;font-family:var(--font-mono);letter-spacing:.5em;font-size:1.3rem;padding:.7rem;}
  .kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-top:1.2rem;}
  .kpi-card{background:var(--surface);border:1px solid var(--line);border-top:3px solid var(--kpi-color,var(--accent));border-radius:12px;padding:.9rem 1rem;}
  .kpi-value{font-family:var(--font-display);font-size:1.9rem;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;}
  .kpi-label{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-dim);margin-top:.3rem;}
  .filters-bar{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:1.5rem 0 1rem;}
  .filters-bar select, .filters-bar input{width:auto;padding:.5rem .7rem;font-size:.84rem;}
  .search-input{flex:1;min-width:160px;}
  .table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface);}
  table{width:100%;border-collapse:collapse;font-size:.86rem;min-width:720px;}
  th{text-align:left;padding:.65rem .9rem;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.04em;font-size:.64rem;color:var(--ink-dim);background:var(--surface-2);border-bottom:1px solid var(--line);white-space:nowrap;}
  td{padding:.65rem .9rem;border-bottom:1px solid var(--line);vertical-align:middle;white-space:nowrap;}
  tbody tr:hover{background:var(--surface-2);cursor:pointer;}
  tbody tr:last-child td{border-bottom:none;}
  .empty-row td{text-align:center;color:var(--ink-dim);padding:2rem;}
  .pill{display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .65rem;border-radius:999px;font-size:.68rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase;white-space:nowrap;}
  .pill-bad{background:var(--bad-soft);color:var(--bad);}
  .pill-warn{background:var(--warn-soft);color:var(--warn);}
  .pill-good{background:var(--good-soft);color:var(--good);}
  .pill-info{background:var(--info-soft);color:var(--info);}
  .type-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:.4rem;}
  .dash-actions{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.6rem;}
  .btn-secondary{background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:.55rem 1rem;font-size:.82rem;font-weight:600;}
  .btn-secondary:hover{border-color:var(--accent);color:var(--accent);}

  details.admin-panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-top:.8rem;overflow:hidden;}
  details.admin-panel summary{padding:.85rem 1.1rem;font-weight:600;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;}
  details.admin-panel summary::-webkit-details-marker{display:none;}
  details.admin-panel summary:after{content:"+";font-family:var(--font-mono);color:var(--ink-dim);}
  details.admin-panel[open] summary:after{content:"\2013";}
  .admin-body{padding:0 1.1rem 1.1rem;border-top:1px solid var(--line);}
  .admin-site-block{padding:.9rem 0;border-bottom:1px dashed var(--line);}
  .admin-site-block:last-child{border-bottom:none;}
  .admin-equip-row{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0;}
  .equip-chip{display:inline-flex;align-items:center;gap:.4rem;background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:.3rem .5rem .3rem .75rem;font-size:.78rem;}
  .equip-chip button{background:none;border:none;color:var(--ink-dim);font-size:.9rem;line-height:1;padding:0 .1rem;}
  .roster-row{display:flex;align-items:center;gap:.7rem;padding:.5rem 0;border-bottom:1px dashed var(--line);}
  .roster-row:last-child{border-bottom:none;}
  .roster-row .rr-meta{flex:1;}
  .field-hint{font-size:.72rem;color:var(--ink-dim);}
  .mini-form{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.7rem;}
  .mini-form input,.mini-form select{width:auto;flex:1;min-width:110px;padding:.5rem .65rem;font-size:.82rem;}
  .mini-form button{background:var(--accent);color:var(--accent-ink);border:none;border-radius:8px;padding:.5rem 1rem;font-weight:600;font-size:.82rem;}
  .remove-btn{background:none;border:none;color:var(--bad);font-size:.78rem;font-weight:600;}

  .overlay{position:fixed;inset:0;background:rgba(10,12,15,.45);display:flex;justify-content:flex-end;z-index:60;}
  .drawer{width:min(440px,92vw);height:100%;background:var(--surface);padding:1.6rem;overflow-y:auto;box-shadow:-8px 0 24px var(--shadow);border-left:1px solid var(--line);}
  .drawer-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;gap:.8rem;}
  .drawer-row{display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px dashed var(--line);font-size:.87rem;}
  .drawer-row dt{color:var(--ink-dim);flex:none;margin:0;}
  .drawer-row dd{margin:0;text-align:right;}
  .drawer-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.3rem;}
  .drawer-actions button{flex:1;padding:.7rem;border-radius:9px;border:1px solid var(--line);background:var(--surface-2);font-weight:600;font-size:.85rem;}
  .drawer-actions button.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);}

  .toast{position:fixed;left:50%;bottom:1.4rem;transform:translate(-50%,8px);background:var(--good);color:#fff;padding:.7rem 1.2rem;border-radius:999px;font-weight:600;font-size:.86rem;box-shadow:0 8px 20px var(--shadow);opacity:0;transition:opacity .18s ease, transform .18s ease;z-index:80;}
  .toast.show{opacity:1;transform:translate(-50%,0);}
  .toast.err{background:var(--bad);}

  @media (max-width:520px){
    .clock{display:none;}
    .worker-name{display:none;}
    th,td{padding:.55rem .6rem;}
  }
</style>
</head>
<body>
<div id="app">
  <header class="chrome" id="chrome"></header>
  <main id="screen" class="screen"></main>
</div>
<div id="toast" class="toast"></div>
<div id="drawer-root"></div>

<script>
(function(){
  "use strict";

  /* =====================================================================
     SETUP: paste your Google Apps Script Web App URL below (see
     SETUP_GUIDE.md). It ends in /exec and looks like:
     https://script.google.com/macros/s/AKfycb.../exec
     ===================================================================== */
  var APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzz4LZTXsstrpEafCWYUUJpQ51kgjnxMBHVIUKBljlxLQfHDo82KnsDmPcVhy3KQM6Q/exec";
  var POLL_MS = 20000;

  /* ================= client-side fallback seed (used only when the
     sheet has no config yet, e.g. before setupSeedData() has run) ====== */
  var CATALOG_SEED = { sites: [
    { id:"in-pilot", name:"India — Pilot Site", equipment:[
      {id:"cbs-1", name:"CBS-1 Cross-Belt Sorter"},
      {id:"dws-1", name:"DWS-1 Dim-Weigh-Scan"},
      {id:"dws-2", name:"DWS-2 Dim-Weigh-Scan"},
      {id:"obs-1", name:"OBS-1 Bag Sorter"}
    ]},
    { id:"vn-dn", name:"Vietnam — SPX DN", equipment:[
      {id:"cbs-1", name:"CBS-1 Triple-Deck Cross-Belt"},
      {id:"obs-1", name:"OBS-1 Bag Sorter"},{id:"obs-2", name:"OBS-2 Bag Sorter"},{id:"obs-3", name:"OBS-3 Bag Sorter"},
      {id:"dws-1", name:"DWS-1"},{id:"dws-2", name:"DWS-2"},{id:"dws-3", name:"DWS-3"},{id:"dws-4", name:"DWS-4"},{id:"dws-5", name:"DWS-5"}
    ]}
  ]};
  var ROSTER_SEED = { workers:[
    {id:"w1",name:"A. Verma",role:"AS Technician"},{id:"w2",name:"S. Iyer",role:"AS Technician"},
    {id:"w3",name:"R. Das",role:"Shift Lead"},{id:"w4",name:"Tran Minh",role:"AS Technician"},
    {id:"w5",name:"Le Hoa",role:"AS Technician"},{id:"w6",name:"Nguyen Anh",role:"Shift Lead"}
  ]};
  var SETTINGS_SEED = { pin:"2468" };

  var BD_CATEGORIES = ["Mechanical","Electrical","Sensor / Scanner","Software / PLC","Jam / Missort","Other"];
  var BD_SEVERITIES = ["Minor","Major","Critical"];
  var PM_FREQ = ["Daily","Weekly","Monthly","Quarterly"];
  var PM_RESULT = ["OK","Issue Found"];
  var PM_TASKS = ["Belt tension check","Photo-eye / sensor cleaning","Chain lubrication","Motor & gearbox inspection","Tray alignment check","Scanner calibration","Encoder check","E-stop & safety circuit test","Housekeeping / debris clearance"];
  var SPARE_NAMES = ["Cross-belt tray","Photo-eye sensor","Drive motor","Gearbox","Roller / bearing","Conveyor belt","Drive chain","Barcode scanner","Encoder","Proximity sensor","E-stop switch"];
  var SPARE_REASONS = ["New Failure","Preventive Replacement","Wear & Tear","Other"];
  var TASK_CATEGORIES = ["Safety","Housekeeping","Improvement","Spares Request","Other"];
  var TASK_PRIORITY = ["Low","Medium","High"];

  var TYPE_META = {
    breakdown:{ label:"Breakdown / Downtime", color:"var(--bad)", soft:"var(--bad-soft)" },
    pm:{ label:"PM Activity", color:"var(--good)", soft:"var(--good-soft)" },
    spares:{ label:"Spares Consumption", color:"var(--info)", soft:"var(--info-soft)" },
    task:{ label:"Task / Issue", color:"var(--warn)", soft:"var(--warn-soft)" }
  };

  function $(sel,root){ return (root||document).querySelector(sel); }
  function $all(sel,root){ return Array.prototype.slice.call((root||document).querySelectorAll(sel)); }
  function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
  function uid(prefix){ return prefix+"-"+Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
  function initials(name){ var p=(name||"?").trim().split(/\s+/); return ((p[0]||"")[0]||"")+((p[1]||"")[0]||""); }
  function isToday(ts){ var a=new Date(ts), b=new Date(); return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate(); }
  function fmtTime(ts){ return new Date(ts).toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"}); }
  function fmtDateTime(ts){ return new Date(ts).toLocaleDateString([], {day:"2-digit",month:"short"}) + " · " + fmtTime(ts); }
  function nowHHMM(){ var d=new Date(); return (d.getHours()<10?"0":"")+d.getHours()+":"+(d.getMinutes()<10?"0":"")+d.getMinutes(); }
  function minutesBetween(startHHMM,endHHMM){
    var s=startHHMM.split(":").map(Number), e=endHHMM.split(":").map(Number);
    var sm=s[0]*60+s[1], em=e[0]*60+e[1];
